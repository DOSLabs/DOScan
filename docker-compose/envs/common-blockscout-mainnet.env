ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=false
ETHEREUM_JSONRPC_PENDING_TRANSACTIONS_TYPE=geth

BLOCKSCOUT_HOST=doscan.io
CHAIN_ID=7979
SUBNETWORK=Mainnet
TOKEN_LIST_URL=https://raw.githubusercontent.com/DOS/DOScan/main/docker-compose/token-lists/mainnet.json

INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=false
INDEXER_INTERNAL_TRANSACTIONS_TRACER_TYPE=call_tracer
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=false

# Keep Mainnet and Testnet media isolated inside the shared public bucket.
# Deploys force-recreate the backend whenever this env file changes.
NFT_MEDIA_HANDLER_BUCKET_FOLDER=mainnet/nft-media

