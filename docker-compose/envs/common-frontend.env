# =============================================================================
# DOS Chain Mainnet - Frontend Environment Variables
# https://doscan.io
# Last Updated: 2026-07-25
# Blockscout Frontend latest
# Docs: https://docs.blockscout.com/setup/env-variables/frontend-common-envs
# =============================================================================

# =============================================================================
# APP CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_APP_HOST=doscan.io
NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_APP_INSTANCE_ID=             # Unique instance ID (multi-instance deployments)
# NEXT_PUBLIC_MAINTENANCE_ALERT_MESSAGE=   # Custom maintenance banner text

# =============================================================================
# BLOCKCHAIN PARAMETERS
# =============================================================================
NEXT_PUBLIC_NETWORK_NAME=DOS Chain
NEXT_PUBLIC_NETWORK_SHORT_NAME=DOS
NEXT_PUBLIC_NETWORK_ID=7979
NEXT_PUBLIC_NETWORK_RPC_URL=https://main.doschain.com
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=DOS
NEXT_PUBLIC_NETWORK_CURRENCY_WEI_NAME=wei
NEXT_PUBLIC_NETWORK_CURRENCY_GWEI_NAME=nDOS
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=DOS
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_NETWORK_TOKEN_STANDARD_NAME=ERC
NEXT_PUBLIC_IS_TESTNET=false
# NEXT_PUBLIC_VALIDATORS_CHAIN_TYPE=poa    # Validator display type: aura, poa, stability
# NEXT_PUBLIC_NETWORK_ALARMS=              # Network alarm notifications config

# =============================================================================
# API CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_HOST=doscan.io
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss
# NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml  # deprecated in latest frontend image
# NEXT_PUBLIC_API_TIMEOUT=10000            # API request timeout in ms (default: 10000)
# NEXT_PUBLIC_SAFE_TX_SERVICE_URL=         # Safe (Gnosis Safe) transaction service API

# =============================================================================
# UI CONFIGURATION - HOMEPAGE
# =============================================================================
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_HOMEPAGE_STATS=['total_blocks','average_block_time','total_txs','wallet_addresses','gas_tracker']
# NEXT_PUBLIC_HOMEPAGE_PLATE_BACKGROUND deprecated - use HERO_BANNER_CONFIG instead
NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG={'background':['linear-gradient(90deg, rgb(232, 52, 53) 0%, rgb(139, 28, 232) 100%)']}

# =============================================================================
# UI CONFIGURATION - NAVIGATION
# =============================================================================
NEXT_PUBLIC_NETWORK_LOGO=https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/network-logos/dos.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/network-logos/dos-dark.svg
NEXT_PUBLIC_NETWORK_ICON=https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/network-icons/dos.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/network-icons/dos.svg
NEXT_PUBLIC_OTHER_LINKS=[{'url':'https://docs.doschain.com/network-details','text':'Network Details'}]
NEXT_PUBLIC_NAVIGATION_LAYOUT=vertical

# =============================================================================
# UI CONFIGURATION - FEATURED NETWORKS
# =============================================================================
NEXT_PUBLIC_FEATURED_NETWORKS=https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/featured-networks/dos.json

# =============================================================================
# UI CONFIGURATION - FOOTER
# =============================================================================
NEXT_PUBLIC_FOOTER_LINKS=https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/footer-links/dos.json

# =============================================================================
# UI CONFIGURATION - FAVICON
# =============================================================================
FAVICON_GENERATOR_API_KEY=e1a48cd13eee979ddfbdff2912a0f772697a9ea9
FAVICON_MASTER_URL=https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/network-icons/dos.svg

# =============================================================================
# UI CONFIGURATION - META & SEO
# =============================================================================
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false
NEXT_PUBLIC_SEO_ENHANCED_DATA_ENABLED=true
NEXT_PUBLIC_OG_DESCRIPTION=Blockchain explorer for DOS Chain. DOScan is an analytics tool for exploring DOS transactions, addresses, statistics, and other platform activities.
NEXT_PUBLIC_OG_IMAGE_URL=https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/og-images/doscan.png
# NEXT_PUBLIC_META_KEYWORDS=               # Meta keywords for SEO

# =============================================================================
# UI CONFIGURATION - ADDRESS & CONTRACT VIEWS
# =============================================================================
NEXT_PUBLIC_VIEWS_CONTRACT_SOLIDITYSCAN_ENABLED=true
NEXT_PUBLIC_VIEWS_TOKEN_SCAM_TOGGLE_ENABLED=true
NEXT_PUBLIC_VIEWS_TX_ADDITIONAL_FIELDS=['fee_per_gas']
NEXT_PUBLIC_VIEWS_TX_GROUPED_FEES=true
# NEXT_PUBLIC_VIEWS_ADDRESS_IDENTICON_TYPE=jazzicon  # Address icon: default, jazzicon, gradient
# NEXT_PUBLIC_VIEWS_TOKEN_HOLDER_DISTRIBUTION_ENABLED=true  # Token holder distribution chart

# =============================================================================
# UI CONFIGURATION - NFT VIEWS
# =============================================================================
NEXT_PUBLIC_VIEWS_NFT_MARKETPLACES=[{'name':'OverMint','collection_url':'https://overmint.io/collection/{hash}','instance_url':'https://overmint.io/{hash}:{id}','logo_url':'https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/marketplace-logos/overmint.png'}]

# =============================================================================
# UI CONFIGURATION - MISCELLANEOUS
# =============================================================================
NEXT_PUBLIC_CONTRACT_CODE_IDES=[{'title':'Remix IDE','url':'https://remix.ethereum.org/?address={hash}&blockscout={domain}','icon_url':'https://remix.ethereum.org/favicon.ico'}]
NEXT_PUBLIC_HIDE_NATIVE_COIN_PRICE=true

# =============================================================================
# FEATURE: GAS TRACKER
# =============================================================================
NEXT_PUBLIC_GAS_TRACKER_ENABLED=true
NEXT_PUBLIC_GAS_TRACKER_UNITS=['gwei']

# =============================================================================
# FEATURE: ADVANCED FILTER
# =============================================================================
NEXT_PUBLIC_ADVANCED_FILTER_ENABLED=true
NEXT_PUBLIC_HAS_USER_OPS=true

# =============================================================================
# FEATURE: ADDRESS VERIFICATION
# =============================================================================
NEXT_PUBLIC_CONTRACT_INFO_API_HOST=https://contracts-info.services.blockscout.com
NEXT_PUBLIC_ADMIN_SERVICE_API_HOST=https://admin-rs.services.blockscout.com
NEXT_PUBLIC_DEX_POOLS_ENABLED=true

# =============================================================================
# FEATURE: BLOCKCHAIN INTERACTION (WALLET CONNECT)
# =============================================================================
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=4b6b77d337588564379b0ef8f3a5c479
# NEXT_PUBLIC_WALLET_CONNECT_RELAY_URL=    # Custom WalletConnect relay server

# =============================================================================
# FEATURE: ADS
# =============================================================================
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# =============================================================================
# FEATURE: GOOGLE ANALYTICS
# =============================================================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_PROPERTY_ID=G-HHJGT5F2WK
# NEXT_PUBLIC_GOOGLE_TAGMANAGER_ID=        # Google Tag Manager container ID
# NEXT_PUBLIC_MIXPANEL_ID=                 # Mixpanel analytics project ID
# NEXT_PUBLIC_PLAUSIBLE_ANALYTICS_DOMAIN=  # Plausible Analytics domain

# =============================================================================
# FEATURE: API DOCUMENTATION
# =============================================================================
# NEXT_PUBLIC_API_DOCS_TABS=['rest_api','eth_rpc_api','graphql_api']  # deprecated in v1.38+

# =============================================================================
# FEATURE: MARKETPLACE
# =============================================================================
NEXT_PUBLIC_MARKETPLACE_ENABLED=true
NEXT_PUBLIC_MARKETPLACE_CONFIG_URL=https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/marketplace/dos.json
NEXT_PUBLIC_MARKETPLACE_SUBMIT_FORM=https://forms.gle/hjBVrXzfxQgSRxNA6
NEXT_PUBLIC_MARKETPLACE_SUGGEST_IDEAS_FORM=https://forms.gle/SEMwUgtRtYmdo3EP6
NEXT_PUBLIC_MARKETPLACE_CATEGORIES_URL=https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/marketplace-categories/default.json
NEXT_PUBLIC_DEFI_DROPDOWN_ITEMS=[{'text':'Swap','icon':'swap','dappId':'doswap'},{'text':'Bridge','dappId':'dos-bridge'}]

# =============================================================================
# FEATURE: TRANSACTION INTERPRETATION
# =============================================================================
NEXT_PUBLIC_TRANSACTION_INTERPRETATION_PROVIDER=none

# =============================================================================
# FEATURE: HOT CONTRACTS
# =============================================================================
NEXT_PUBLIC_HOT_CONTRACTS_ENABLED=true

# =============================================================================
# FEATURE: GET GAS BUTTON
# =============================================================================
NEXT_PUBLIC_GAS_REFUEL_PROVIDER_CONFIG={'name':'DOS Faucet','dapp_id':'dos-faucet','url_template':'https://faucet.doschain.com','logo':'https://raw.githubusercontent.com/DOSLabs/DOScan-Frontend-Configs/main/configs/network-icons/dos.svg'}

# Version info is set via Docker build args, not env
# NEXT_PUBLIC_GIT_TAG=
# NEXT_PUBLIC_GIT_COMMIT_SHA=
NEXT_PUBLIC_BACKEND_REPO_URL=https://github.com/DOS/DOScan
NEXT_PUBLIC_FRONTEND_REPO_URL=https://github.com/DOS/DOScan-Frontend
NEXT_PUBLIC_VERSION_LINK_TYPE=release

# =============================================================================
# FEATURE: STATS SERVICE
# =============================================================================
NEXT_PUBLIC_STATS_API_HOST=https://stats.doscan.io

# =============================================================================
# FEATURE: VISUALIZE API
# =============================================================================
NEXT_PUBLIC_VISUALIZE_API_HOST=https://viz.doscan.io

# =============================================================================
# FEATURE: METADATA SERVICE
# =============================================================================
NEXT_PUBLIC_METADATA_SERVICE_API_HOST=https://metadata.services.blockscout.com
NEXT_PUBLIC_METADATA_ADDRESS_TAGS_UPDATE_ENABLED=true

# =============================================================================
# FEATURE: METASUITES
# =============================================================================
NEXT_PUBLIC_METASUITES_ENABLED=true
# NEXT_PUBLIC_METASUITES_API_HOST=         # Custom Metasuites API endpoint

# =============================================================================
# FEATURE: WEB3 WALLETS
# =============================================================================
NEXT_PUBLIC_WEB3_WALLETS=["metamask","rabby","coinbase","token_pocket"]
NEXT_PUBLIC_WEB3_DISABLE_ADD_TOKEN_TO_WALLET=false

# =============================================================================
# FEATURE: STAKING & VALIDATORS (NOT YET CONFIGURED)
# =============================================================================
# NEXT_PUBLIC_STAKING_ENABLED=false        # Enable staking info display
# NEXT_PUBLIC_VALIDATORS_SORTING_ENABLED=true  # Enable validator list sorting

