# =============================================================================
# DOS Chain Testnet - Backend Environment OVERRIDES
# Base: common-blockscout.env (mainnet)
# Only values that differ from base are listed here.
# Docker Compose loads base first, then this file overrides.
# =============================================================================

# RPC - local avago container (testnet blockchain ID)
ETHEREUM_JSONRPC_HTTP_URL=http://avago:9650/ext/bc/e4PHth8utBAPorg4sFRTaWmDfUWf9X8nAECczGx1BJVmYBv3A/rpc
ETHEREUM_JSONRPC_TRACE_URL=http://avago:9650/ext/bc/e4PHth8utBAPorg4sFRTaWmDfUWf9X8nAECczGx1BJVmYBv3A/rpc
ETHEREUM_JSONRPC_WS_URL=ws://avago:9650/ext/bc/e4PHth8utBAPorg4sFRTaWmDfUWf9X8nAECczGx1BJVmYBv3A/ws

# Database - local postgres container
DATABASE_URL=postgresql://postgres:@db:5432/blockscout?ssl=false
SECRET_KEY_BASE=RMgI4C1HSkxsEjdhtGMfwAHfyT6CKWXOgzCboJflfSm4jeAber4AuFdWuqry7prU

# Network
CHAIN_ID=3939
SUBNETWORK=Testnet
BLOCKSCOUT_HOST=test.doscan.io

# The current Testnet RPC does not expose txpool_content or debug tracing.
# Keep these fetchers disabled until the node APIs are enabled and verified.
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true

# Cloudflare-aware API throttling and SSRF protection
API_RATE_LIMIT_IS_BLOCKSCOUT_BEHIND_PROXY=true
API_RATE_LIMIT_REMOTE_IP_HEADERS=cf-connecting-ip,x-forwarded-for
INDEXER_TOKEN_INSTANCE_CIDR_BLACKLIST=0.0.0.0/8,10.0.0.0/8,100.64.0.0/10,127.0.0.0/8,169.254.0.0/16,172.16.0.0/12,192.0.0.0/24,192.0.2.0/24,192.168.0.0/16,198.18.0.0/15,198.51.100.0/24,203.0.113.0/24,224.0.0.0/4,240.0.0.0/4

# Operations and observability
DISABLE_FILE_LOGGING=true
ADMIN_PANEL_ENABLED=false
HEALTH_MONITOR_CHECK_INTERVAL=5m
HEALTH_MONITOR_BLOCKS_PERIOD=1h
PUBLIC_METRICS_ENABLED=true
PUBLIC_METRICS_UPDATE_PERIOD_HOURS=1

# No verified EntryPoint contracts are deployed on Testnet yet.
MICROSERVICE_ACCOUNT_ABSTRACTION_ENABLED=false

# Disable NFT media downloads until isolated media infrastructure is deployed.
NFT_MEDIA_HANDLER_ENABLED=false

# Sourcify
SOURCIFY_INTEGRATION_ENABLED=true
SOURCIFY_SERVER_URL=https://sourcify.dev/server
SOURCIFY_REPO_URL=https://repo.sourcify.dev/contracts

# Verifier type — eth_bytecode_db auto-matches bytecodes across all Blockscout instances
MICROSERVICE_SC_VERIFIER_ENABLED=true
MICROSERVICE_SC_VERIFIER_URL=https://eth-bytecode-db.services.blockscout.com/
MICROSERVICE_SC_VERIFIER_TYPE=eth_bytecode_db
MICROSERVICE_ETH_BYTECODE_DB_INTERVAL_BETWEEN_LOOKUPS=10m
MICROSERVICE_ETH_BYTECODE_DB_MAX_LOOKUPS_CONCURRENCY=10
