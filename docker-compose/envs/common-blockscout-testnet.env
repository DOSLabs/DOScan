# =============================================================================
# DOS Chain Testnet - Backend Environment OVERRIDES
# Base: common-blockscout.env (mainnet)
# Only values that differ from base are listed here.
# Docker Compose loads base first, then this file overrides.
# =============================================================================

# RPC - local avago container (testnet blockchain ID)
ETHEREUM_JSONRPC_HTTP_URL=http://avago:9650/ext/bc/e4PHth8utBAPorg4sFRTaWmDfUWf9X8nAECczGx1BJVmYBv3A/rpc
ETHEREUM_JSONRPC_TRACE_URL=http://avago:9650/ext/bc/e4PHth8utBAPorg4sFRTaWmDfUWf9X8nAECczGx1BJVmYBv3A/rpc
ETHEREUM_JSONRPC_WS_URL=ws://avago:9650/ext/bc/e4PHth8utBAPorg4sFRTaWmDfUWf9X8nAECczGx1BJVmYBv3A/ws

# Database - local postgres container
DATABASE_URL=postgresql://postgres:@db:5432/blockscout?ssl=false
SECRET_KEY_BASE=RMgI4C1HSkxsEjdhtGMfwAHfyT6CKWXOgzCboJflfSm4jeAber4AuFdWuqry7prU

# Network
CHAIN_ID=3939
SUBNETWORK=Testnet
BLOCKSCOUT_HOST=test.doscan.io

# The current Testnet RPC does not expose txpool_content or debug tracing.
# Keep these fetchers disabled until the node APIs are enabled and verified.
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true

# No verified EntryPoint contracts are deployed on Testnet yet.
MICROSERVICE_ACCOUNT_ABSTRACTION_ENABLED=false
