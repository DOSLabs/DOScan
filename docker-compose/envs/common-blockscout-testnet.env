# =============================================================================
# DOS Chain Testnet - Backend Environment OVERRIDES
# Base: common-blockscout.env (mainnet)
# Only values that differ from base are listed here.
# Docker Compose loads base first, then this file overrides.
# =============================================================================

# RPC - archive AvalancheGo node on dos-testnet-r0
ETHEREUM_JSONRPC_HTTP_URL=http://10.148.0.7:9650/ext/bc/2EhCz8u48mSCUzxEEGsqY7d1PnqUKkc2B1zkTQaJxbT99wshkJ/rpc
ETHEREUM_JSONRPC_TRACE_URL=http://10.148.0.7:9650/ext/bc/2EhCz8u48mSCUzxEEGsqY7d1PnqUKkc2B1zkTQaJxbT99wshkJ/rpc
ETHEREUM_JSONRPC_WS_URL=ws://10.148.0.7:9650/ext/bc/2EhCz8u48mSCUzxEEGsqY7d1PnqUKkc2B1zkTQaJxbT99wshkJ/ws
ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=false

# Network
CHAIN_ID=3939
SUBNETWORK=Testnet
BLOCKSCOUT_HOST=test.doscan.io

# DOS Name Service is enabled only on Testnet until the ENSv2 stack is deployed on Mainnet.
MICROSERVICE_BENS_ENABLED=true
MICROSERVICE_BENS_URL=http://bens:8050/
MICROSERVICE_BENS_PROTOCOLS=dos-names

# Keep Testnet media separate from Mainnet media in the shared public bucket.
NFT_MEDIA_HANDLER_BUCKET_FOLDER=testnet/nft-media

# The current Testnet RPC does not expose txpool_content or debug tracing.
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
