# DOS Chain relaunched mainnet explorer overrides.
# Base configuration is loaded from common-frontend.env first.

NEXT_PUBLIC_APP_HOST=doscan.io
NEXT_PUBLIC_NETWORK_RPC_URL=https://main3.doschain.com

NEXT_PUBLIC_API_HOST=doscan.io
NEXT_PUBLIC_STATS_API_HOST=https://doscan.io
NEXT_PUBLIC_STATS_API_BASE_PATH=/stats-api
NEXT_PUBLIC_VISUALIZE_API_HOST=https://doscan.io/visualize
NEXT_PUBLIC_METADATA_SERVICE_API_HOST=https://doscan.io/metadata-api
NEXT_PUBLIC_CONTRACT_INFO_API_HOST=https://doscan.io
NEXT_PUBLIC_INTERCHAIN_INDEXER_API_HOST=https://doscan.io
NEXT_PUBLIC_CROSS_CHAIN_TXS_ENABLED=true
NEXT_PUBLIC_NAME_SERVICE_API_HOST=https://doscan.io
NEXT_PUBLIC_NAME_SERVICE_PROTOCOLS=['dos-names']

NEXT_PUBLIC_HOMEPAGE_STATS=['total_blocks','average_block_time','total_txs','wallet_addresses','gas_tracker']
