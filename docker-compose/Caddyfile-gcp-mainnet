:80 {
	encode zstd gzip

	header >Cross-Origin-Opener-Policy "same-origin-allow-popups"

	# Invalidate browser HTTP caches once after the intentional July 2026 chain reset.
	@pre_relaunch_cache {
		not header_regexp Cookie "(^|;\s*)dos_chain_epoch=20260708(;|$)"
	}
	header @pre_relaunch_cache {
		Clear-Site-Data "\"cache\""
		+Set-Cookie "dos_chain_epoch=20260708; Path=/; Max-Age=31536000; Secure; SameSite=Lax"
	}

	handle /api/v1/counters {
		reverse_proxy stats:8050
	}
	handle /api/v1/lines {
		reverse_proxy stats:8050
	}
	handle /api/v1/pages/main {
		reverse_proxy stats:8050
	}
	handle /api/* {
		reverse_proxy backend:4000
	}
	handle /socket/* {
		reverse_proxy backend:4000
	}
	handle /sitemap.xml {
		reverse_proxy backend:4000
	}
	handle /auth/* {
		reverse_proxy backend:4000
	}
	handle_path /metadata-api/* {
		reverse_proxy https://metadata.services.blockscout.com {
			header_up Host metadata.services.blockscout.com
		}
	}
	handle /metrics {
		reverse_proxy backend:4000
	}
	handle /public-metrics {
		reverse_proxy backend:4000
	}
	handle /stats-api/* {
		uri strip_prefix /stats-api
		reverse_proxy stats:8050
	}
	handle /visualize/* {
		reverse_proxy visualizer:8050
	}
	handle {
		reverse_proxy frontend:3000
	}
}
