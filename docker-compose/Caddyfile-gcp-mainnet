:80 {
	encode zstd gzip

	header >Cross-Origin-Opener-Policy "same-origin-allow-popups"

	# Invalidate browser HTTP caches once for the v2.10.0 frontend rollout.
	@pre_relaunch_cache {
		not header_regexp Cookie "(^|;\s*)dos_chain_epoch=20260803(;|$)"
	}
	header @pre_relaunch_cache {
		Clear-Site-Data "\"cache\""
		+Set-Cookie "dos_chain_epoch=20260803; Path=/; Max-Age=31536000; Secure; SameSite=Lax"
	}

	# Turbopack chunk names may remain stable across builds, so they must be revalidated.
	@frontend_runtime_assets path /assets/envs.js /_next/static/chunks/*
	header @frontend_runtime_assets >Cache-Control "public, max-age=0, must-revalidate"

	handle /api/v1/counters {
		reverse_proxy stats:8050
	}
	handle /api/v1/lines {
		reverse_proxy stats:8050
	}
	handle /api/v1/pages/main {
		reverse_proxy stats:8050
	}
	@interchain_indexer path /api/v1/interchain/* /api/v1/status/indexers /api/v1/stats/common /api/v1/stats/daily /api/v1/stats/chains /api/v1/stats/chain/*
	handle @interchain_indexer {
		reverse_proxy interchain-indexer:8050
	}
	handle /api/v1/chains/* {
		reverse_proxy https://contracts-info.services.blockscout.com {
			header_up Host contracts-info.services.blockscout.com
			header_up -Cookie
			header_up -Authorization
		}
	}
	@metadata_api path /api/v1/metadata /api/v1/tags:search /api/v1/public-tag-types /api/v1/addresses:submit
	handle @metadata_api {
		reverse_proxy https://metadata.services.blockscout.com {
			header_up Host metadata.services.blockscout.com
			header_up -Cookie
			header_up -Authorization
		}
	}
	handle /api/* {
		reverse_proxy backend:4000
	}
	handle /socket/* {
		reverse_proxy backend:4000
	}
	handle /sitemap.xml {
		reverse_proxy backend:4000
	}
	handle /auth/* {
		reverse_proxy backend:4000
	}
	handle_path /metadata-api/* {
		reverse_proxy https://metadata.services.blockscout.com {
			header_up Host metadata.services.blockscout.com
			header_up -Cookie
			header_up -Authorization
		}
	}
	handle /metrics {
		reverse_proxy backend:4000
	}
	handle /public-metrics {
		reverse_proxy backend:4000
	}
	handle /stats-api/* {
		uri strip_prefix /stats-api
		reverse_proxy stats:8050
	}
	handle /visualize/* {
		reverse_proxy visualizer:8050
	}
	handle_path /name-service/* {
		reverse_proxy bens:8050
	}
	handle {
		reverse_proxy frontend:3000
	}
}
